# Copy this file to .env for local Compose use.
# This token is only for a local demonstration; use a secret manager in deployment.
GATEWAY_TOKEN=change-me-local-only

# Start the cloud once, read /health.pqc.public_key_fingerprint, then set it here.
CLOUD_KEY_FINGERPRINT=replace-with-64-character-cloud-fingerprint

# Keep the legacy endpoint enabled during migration; set false after all gateways upgrade.
LEGACY_INGEST_ENABLED=true

DEVICE_ID=dev-001
DEVICE_INTERVAL=2
CRYPTO_MODE=mlkem
